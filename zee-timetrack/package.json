{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/login.html"  // Redirecionamento para a tela de login
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js" // Rota para o seu backend
    }
  ]
}
