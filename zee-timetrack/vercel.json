{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/login.html"  
    },
  
    {
      "src": "/(.*\\.(?:html|js|css|png|jpg|gif|svg))$",
      "dest": "/$1"
    },

    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
